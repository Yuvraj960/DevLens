# DevLens Production Environment Configuration Template

# Database Settings
POSTGRES_DB=devlens_prod
POSTGRES_USER=devlens_admin
POSTGRES_PASSWORD=change_this_to_strong_secure_password_123

# Redis Settings
REDIS_URL=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=devlens_code_chunks

# LLM & Embedding Model Settings
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=ollama/bge-m3
LLM_MODEL=ollama/deepseek-coder:6.7b-instruct

# Optional External AI Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
